@page "/events"
@using EventCard.Models

<h2>Upcoming Events</h2>

@foreach (var evt in Events)
{
    <EventCard Event="evt" />
}

@code {
    private List<Event> Events = new()
    {
        new Event
        {
            Name = "Tech Conference 2026",
            Date = new DateTime(2026, 11, 15),
            Location = "New York, NY"
        },
        new Event
        {
            Name = "Blazor Summit",
            Date = new DateTime(2026, 12, 5),
            Location = "Seattle, WA"
        },
        new Event
        {
            Name = "Developer Meetup",
            Date = new DateTime(2027, 1, 20),
            Location = "Austin, TX"
        }
    };
}