@page "/events/{Id:int}/register"
@inject UserSessionTracker SessionTracker

<h2>Event Registration</h2>

<EditForm Model="@registration" OnValidSubmit="HandleRegistration">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control"
                   @bind-Value="registration.Name" />
        <ValidationMessage For="@(() => registration.Name)" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control"
                   @bind-Value="registration.Email" />
        <ValidationMessage For="@(() => registration.Email)" />
    </div>

    <div class="mb-3">
        <label>Phone Number</label>
        <InputText class="form-control"
                   @bind-Value="registration.PhoneNumber" />
        <ValidationMessage For="@(() => registration.PhoneNumber)" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Register
    </button>
</EditForm>

@if (RegistrationSuccess)
{
    <div class="alert alert-success mt-3">
        Registration completed successfully.
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RegistrationModel registration = new();

    private bool RegistrationSuccess;

    protected override void OnInitialized()
    {
        registration.EventId = Id;
    }

    private void HandleRegistration()
    {
        SessionTracker.RegisteredEvents.Add(Id);

        RegistrationSuccess = true;
    }
}