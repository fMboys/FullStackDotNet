@page "/fetchproducts"
@using System.Text.Json
@inject HttpClient Http

<h3>Product List</h3>

<ul>
    @if (products != null)
    {
        foreach (var product in products)
        {
            <li>@product.Name - $@product.Price</li>
        }
    }
    else
    {
        <li>Loading...</li>
    }
</ul>

@code {
    private Product[]? products;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Copilot suggested using GetFromJsonAsync<T>()
        // to simplify API consumption and automatic
        // JSON deserialization.
            @* products = await Http.GetFromJsonAsync<Product[]>("/api/productlist"); *@
            var response = await Http.GetAsync("/api/productlist");
            response.EnsureSuccessStatusCode();
            var json = await response.Content.ReadAsStringAsync();
            products = JsonSerializer.Deserialize<Product[]>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? Array.Empty<Product>();
                    // Copilot identified a mismatch between the API JSON
        // structure and the Blazor Product model and recommended
        // returning a Product array directly from the API.
        }
        catch (Exception ex)
        {
             // Copilot recommended exception handling to prevent
        // UI failures when the API is unavailable.
            Console.WriteLine($"Error loading products: {ex.Message}");
            products = Array.Empty<Product>();
        }
    }

    public class Product
    {
       // [JsonPropertyName("Id")]
        public int? Id { get; set; }
       
        public string? Name { get; set; } = string.Empty;


        public double? Price { get; set; }

        public int? Stock { get; set; }
    }
}