@code {
    private List<string> Projects = new()
    {
        "SkillSnap Platform",
        "Inventory Management System",
        "Task Tracker App",
        "Portfolio Website"
    };
}

<div class="card p-3 shadow-sm">
    <h4>Projects</h4>

    <ul class="list-group">
        @foreach (var project in Projects)
        {
            <li class="list-group-item">
                @project
            </li>
        }
    </ul>
</div>